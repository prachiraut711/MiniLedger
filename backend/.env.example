# MiniLedger Backend Configuration

# Server Port
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger

# JWT Authentication
JWT_SECRET=miniledger_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Mock OTP Expiry in Minutes
OTP_EXPIRY_MINUTES=5
